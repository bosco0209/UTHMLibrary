@model User
@{
    ViewData["Title"] = "User Details";
    var studyBookings = ViewBag.StudyBookings as List<StudyRoomBooking>;
    var meetingBookings = ViewBag.MeetingBookings as List<MeetingRoomBooking>;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-person"></i> User Details</h1>
        <p>View user information and booking history</p>
    </div>
    <div>
        <a href="@Url.Action("Users", "Admin")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Users
        </a>
        @if (Model.Role != "Admin")
        {
            <form asp-action="ForceDeleteUser" method="post" class="d-inline" onsubmit="return confirmForceDelete('@Model.FullName')">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3"></i> Delete User
                </button>
            </form>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">User Information</h5>
                <hr />
                <p><strong>Name:</strong> @Model.FullName</p>
                <p><strong>Matric Number:</strong> @Model.MatricNumber</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Faculty:</strong> @Model.Faculty</p>
                <p><strong>Phone:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)</p>
                <p><strong>Role:</strong> <span class="badge @(Model.Role == "Admin" ? "bg-warning" : "bg-primary")">@Model.Role</span></p>
                <p><strong>Joined:</strong> @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
                <p><strong>Total Bookings:</strong> <span class="badge bg-info">@ViewBag.TotalBookings</span></p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Study Room Bookings</h5>
            </div>
            <div class="card-body">
                @if (studyBookings != null && studyBookings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Room</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in studyBookings)
                                {
                                    <tr>
                                        <td>@b.StudyRoom?.RoomNumber</td>
                                        <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                                        <td>@b.StartTime - @b.EndTime</td>
                                        <td>RM @b.AmountPaid.ToString("F2")</td>
                                        <td><span class="badge @(b.Status == "Confirmed" ? "bg-success" : "bg-secondary")">@b.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No study room bookings.</p>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Meeting Room Bookings</h5>
            </div>
            <div class="card-body">
                @if (meetingBookings != null && meetingBookings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Room</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Purpose</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in meetingBookings)
                                {
                                    <tr>
                                        <td>@b.MeetingRoom?.RoomNumber</td>
                                        <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                                        <td>@b.StartTime - @b.EndTime</td>
                                        <td>@b.Purpose</td>
                                        <td><span class="badge @(b.Status == "Approved" ? "bg-success" : b.Status == "Pending" ? "bg-warning" : "bg-secondary")">@b.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No meeting room bookings.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmForceDelete(userName) {
            return confirm(`⚠️ FORCE DELETE: "${userName}"\n\nThis will:\n• Delete the user account\n• Delete ALL their bookings\n• Make their booked rooms available again\n\nAre you sure?`);
        }
    </script>
}