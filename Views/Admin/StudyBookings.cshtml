@model List<StudyRoomBooking>
@{
    ViewData["Title"] = "Study Bookings";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-calendar-check"></i> Study Room Bookings</h1>
        <p>Manage all study room bookings</p>
    </div>
</div>

<div class="table-card">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>User</th>
                <th>Room</th>
                <th>Date</th>
                <th>Time</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@(b.User?.FullName ?? "N/A")</td>
                        <td>@(b.StudyRoom?.RoomNumber ?? "N/A")</td>
                        <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                        <td>@b.StartTime - @b.EndTime</td>
                        <td>RM @b.AmountPaid.ToString("F2")</td>
                        <td>
                            <span class="badge @(b.Status == "Confirmed" ? "badge-confirmed" : "badge-cancelled")">
                                @b.Status
                            </span>
                        </td>
                        <td>
                            @if (b.Status == "Confirmed")
                            {
                                <form asp-action="CancelStudyBooking" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Cancel this booking?')">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-3">No study bookings found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>