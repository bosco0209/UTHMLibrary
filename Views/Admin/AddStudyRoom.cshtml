@model StudyRoom
@{
    ViewData["Title"] = "Add Study Room";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="payment-card">
            <h4 class="mb-3"><i class="bi bi-door-open"></i> Add Study Room</h4>
            <p class="text-muted">Add a new study room to the system.</p>

            <form asp-action="AddStudyRoom" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RoomNumber" class="form-label">Room Number</label>
                    <input asp-for="RoomNumber" class="form-control" placeholder="SR-01" />
                    <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" placeholder="Level 2, Main Library" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Capacity" class="form-label">Capacity</label>
                        <input asp-for="Capacity" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Price (RM)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-uthm w-100">
                    <i class="bi bi-plus"></i> Add Study Room
                </button>
            </form>
        </div>
    </div>
</div>