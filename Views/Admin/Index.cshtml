@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-speedometer2"></i> Admin Dashboard</h1>
        <p>Welcome, @User.Identity?.Name!</p>
    </div>
    <span class="badge bg-danger fs-6">Administrator</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <p class="stat-value">@ViewBag.TotalUsers</p>
            <p class="stat-label">Total Students</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card green">
            <div class="stat-icon"><i class="bi bi-journals"></i></div>
            <p class="stat-value">@ViewBag.TotalResources</p>
            <p class="stat-label">Total Resources</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card accent">
            <div class="stat-icon"><i class="bi bi-door-open"></i></div>
            <p class="stat-value">@ViewBag.AvailableStudyRooms / @ViewBag.TotalStudyRooms</p>
            <p class="stat-label">Study Rooms Available</p>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="stat-card gold">
            <div class="stat-icon"><i class="bi bi-currency-ringgit"></i></div>
            <p class="stat-value">RM @ViewBag.TotalRevenue?.ToString("F2")</p>
            <p class="stat-label">Total Revenue</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="stat-card" style="border-left-color: #ff9800;">
            <div class="stat-icon" style="background: rgba(255,152,0,0.1); color: #ff9800;"><i class="bi bi-clock-history"></i></div>
            <p class="stat-value">@ViewBag.PendingMeetingBookings</p>
            <p class="stat-label">Pending Meeting Bookings</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card" style="border-left-color: #2196f3;">
            <div class="stat-icon" style="background: rgba(33,150,243,0.1); color: #2196f3;"><i class="bi bi-check-circle"></i></div>
            <p class="stat-value">@ViewBag.ConfirmedStudyBookings</p>
            <p class="stat-label">Confirmed Study Bookings</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="table-card">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="bi bi-clock"></i> Recent Study Bookings</h6>
            </div>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Room</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentStudyBookings != null && ViewBag.RecentStudyBookings.Count > 0)
                    {
                        foreach (var b in ViewBag.RecentStudyBookings)
                        {
                            <tr>
                                <td>@b.User?.FullName</td>
                                <td>@b.StudyRoom?.RoomNumber</td>
                                <td>@b.BookingDate.ToString("dd MMM")</td>
                                <td><span class="badge @(b.Status == "Confirmed" ? "badge-confirmed" : "badge-cancelled")">@b.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted">No recent bookings</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="table-card">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="bi bi-clock"></i> Recent Meeting Bookings</h6>
            </div>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Room</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentMeetingBookings != null && ViewBag.RecentMeetingBookings.Count > 0)
                    {
                        foreach (var b in ViewBag.RecentMeetingBookings)
                        {
                            <tr>
                                <td>@b.User?.FullName</td>
                                <td>@b.MeetingRoom?.RoomNumber</td>
                                <td>@b.BookingDate.ToString("dd MMM")</td>
                                <td><span class="badge @(b.Status == "Approved" ? "badge-approved" : b.Status == "Pending" ? "badge-pending" : "badge-rejected")">@b.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted">No recent bookings</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>