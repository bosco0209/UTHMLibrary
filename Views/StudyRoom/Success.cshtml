@model StudyRoomBooking
@{
    ViewData["Title"] = "Booking Successful";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="payment-card text-center">
            <i class="bi bi-check-circle-fill" style="font-size: 4rem; color: #16a34a;"></i>
            <h2 class="mt-3">Booking Confirmed!</h2>
            <p class="text-muted">Your study room booking has been confirmed.</p>

            <div class="text-start mt-4">
                <div class="row border-bottom py-2">
                    <div class="col-6 text-muted">Booking Reference</div>
                    <div class="col-6"><strong>#@Model.Id</strong></div>
                </div>
                <div class="row border-bottom py-2">
                    <div class="col-6 text-muted">Room</div>
                    <div class="col-6"><strong>@Model.StudyRoom?.RoomNumber</strong></div>
                </div>
                <div class="row border-bottom py-2">
                    <div class="col-6 text-muted">Date</div>
                    <div class="col-6"><strong>@Model.BookingDate.ToString("dd MMM yyyy")</strong></div>
                </div>
                <div class="row border-bottom py-2">
                    <div class="col-6 text-muted">Time</div>
                    <div class="col-6"><strong>@Model.StartTime - @Model.EndTime</strong></div>
                </div>
                <div class="row py-2">
                    <div class="col-6 text-muted">Amount Paid</div>
                    <div class="col-6"><strong>RM @Model.AmountPaid.ToString("F2")</strong></div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-uthm">
                    <i class="bi bi-speedometer2"></i> Go to Dashboard
                </a>
                <a asp-controller="StudyRoom" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-door-open"></i> Book Another
                </a>
            </div>
        </div>
    </div>
</div>